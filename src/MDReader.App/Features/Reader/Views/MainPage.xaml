<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="MDReader.App.Features.Reader.Views.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:MDReader.App.Features.Reader.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!--
            Main content area of the application.
            Phase 1: shows the empty-reader welcome state. No file opening or
            Markdown rendering is implemented yet (Phase 2).
        -->
        <Grid Background="{ThemeResource AppBackgroundBrush}">
            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="12"
                MaxWidth="480">
                <TextBlock
                    Text="MDReader"
                    FontSize="{StaticResource AppHeadingFontSize}"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource AppTextBrush}"
                    HorizontalAlignment="Center" />
                <TextBlock
                    Text="No document open"
                    Style="{StaticResource AppBodyTextStyle}"
                    HorizontalAlignment="Center" />
                <TextBlock
                    Text="Select a Markdown file to read."
                    Style="{StaticResource AppSecondaryTextStyle}"
                    HorizontalAlignment="Center"
                    TextAlignment="Center" />
            </StackPanel>
        </Grid>
</Page>
