<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="MDReader.App.Features.Shell.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:MDReader.App.Features.Shell.Views"
    xmlns:shellVm="using:MDReader.App.Features.Shell.ViewModels"
    xmlns:mu="using:Microsoft.UI.Xaml.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="{Binding WindowTitle}"
    mc:Ignorable="d">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid" TabFocusNavigation="Cycle" AutomationProperties.Name="MDReader application" AllowDrop="True" DragOver="RootGrid_DragOver" Drop="RootGrid_Drop">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar x:Name="AppTitleBar" Grid.Row="0" Title="{Binding WindowTitle}" AutomationProperties.Name="MDReader title bar">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="ms-appx:///Assets/AppIcon.ico" />
            </TitleBar.IconSource>
        </TitleBar>

        <!-- Menu bar: File, View, Settings, Help -->
        <MenuBar Grid.Row="1" Background="{ThemeResource AppBackgroundBrush}" AutomationProperties.Name="Application menu bar">
            <MenuBarItem x:Name="FileMenuBarItem" Title="ملف">
                <MenuFlyoutItem x:Name="MenuNewItem" Text="📄 جديد  (Ctrl+N)" Command="{Binding NewDocumentCommand}" />
                <MenuFlyoutItem x:Name="MenuOpenItem" Text="📂 فتح ملف...  (Ctrl+O)" Command="{Binding OpenDocumentCommand}" />
                <MenuFlyoutItem x:Name="MenuOpenFolderItem" Text="📁 فتح مجلد...  (Ctrl+Shift+O)" Command="{Binding OpenFolderCommand}" />
                <MenuFlyoutSubItem x:Name="RecentFilesMenuSubItem" Text="🕒 الملفات المشاهدة مؤخراً" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem x:Name="MenuSaveItem" Text="💾 حفظ  (Ctrl+S)" Command="{Binding SaveDocumentCommand}" />
                <MenuFlyoutItem x:Name="MenuSaveAsItem" Text="💾 حفظ باسم...  (Ctrl+Shift+S)" Command="{Binding SaveDocumentAsCommand}" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem x:Name="MenuCloseTabItem" Text="❌ إغلاق التاب  (Ctrl+W)" Command="{Binding CloseCurrentTabCommand}" />
            </MenuBarItem>
            <MenuBarItem x:Name="ViewMenuBarItem" Title="عرض">
                <MenuFlyoutItem x:Name="MenuCommandPaletteItem" Text="⚡ لوحة الأوامر...  (Ctrl+Shift+P / F2)" Click="CommandPalette_Click" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem x:Name="MenuToggleSidebarItem" Text="📑 الشريط الجانبي  (Ctrl+B)" Command="{Binding ToggleWorkspacePaneCommand}" />
                <MenuFlyoutItem x:Name="MenuToggleTypewriterItem" Text="⌨️ وضع الآلة الكاتبة" Click="ToggleTypewriter_Click" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem x:Name="MenuRefreshItem" Text="🔄 تحديث  (Ctrl+R)" Command="{Binding RefreshDocumentCommand}" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem x:Name="MenuFindItem" Text="🔍 بحث في الملف...  (Ctrl+F)" Click="Find_Click" />
                <MenuFlyoutItem x:Name="MenuReplaceItem" Text="✏️ استبدال...  (Ctrl+H)" Click="Replace_Click" />
            </MenuBarItem>
            <MenuBarItem x:Name="SettingsMenuBarItem" Title="الإعدادات">
                <MenuFlyoutSubItem x:Name="MenuThemeSubItem" Text="🎨 المظهر">
                    <MenuFlyoutItem x:Name="MenuThemeSystemItem" Text="💻 حسب النظام" Command="{Binding SetThemeCommand}" CommandParameter="System" />
                    <MenuFlyoutItem x:Name="MenuThemeLightItem" Text="☀️ فاتح (أبيض)" Command="{Binding SetThemeCommand}" CommandParameter="Light" />
                    <MenuFlyoutItem x:Name="MenuThemeDarkItem" Text="🌙 داكن (أسود)" Command="{Binding SetThemeCommand}" CommandParameter="Dark" />
                    <MenuFlyoutItem x:Name="MenuThemeDarkSlateItem" Text="🌑 رمادي غامق فاحم" Command="{Binding SetThemeCommand}" CommandParameter="DarkSlate" />
                    <MenuFlyoutItem x:Name="MenuThemeSepiaItem" Text="📜 مريح للقراءة (بيج)" Command="{Binding SetThemeCommand}" CommandParameter="Sepia" />
                </MenuFlyoutSubItem>
                <MenuFlyoutSubItem x:Name="MenuPreferencesSubItem" Text="⚙️ الخيارات والأتمتة">
                    <ToggleMenuFlyoutItem x:Name="AutoSaveToggleItem" Text="💾 حفظ المسودات تلقائياً" Click="AutoSaveToggle_Click" />
                    <ToggleMenuFlyoutItem x:Name="RestoreSessionToggleItem" Text="🔄 استئناف التابات السابقة" Click="RestoreSessionToggle_Click" />
                    <ToggleMenuFlyoutItem x:Name="TypewriterToggleItem" Text="⌨️ وضع الآلة الكاتبة" Click="TypewriterToggle_Click" />
                </MenuFlyoutSubItem>
                <MenuFlyoutSubItem x:Name="MenuLanguageSubItem" Text="🌐 اللغة">
                    <MenuFlyoutItem Text="العربية (Arabic)" Command="{Binding SetLanguageCommand}" CommandParameter="ar" />
                    <MenuFlyoutItem Text="English" Command="{Binding SetLanguageCommand}" CommandParameter="en" />
                    <MenuFlyoutItem Text="Español (Spanish)" Command="{Binding SetLanguageCommand}" CommandParameter="es" />
                    <MenuFlyoutItem Text="हिन्दी (Hindi)" Command="{Binding SetLanguageCommand}" CommandParameter="hi" />
                    <MenuFlyoutItem Text="中文 (Chinese Simplified)" Command="{Binding SetLanguageCommand}" CommandParameter="zh" />
                    <MenuFlyoutItem Text="Français (French)" Command="{Binding SetLanguageCommand}" CommandParameter="fr" />
                    <MenuFlyoutItem Text="Deutsch (German)" Command="{Binding SetLanguageCommand}" CommandParameter="de" />
                    <MenuFlyoutItem Text="Русский (Russian)" Command="{Binding SetLanguageCommand}" CommandParameter="ru" />
                    <MenuFlyoutItem Text="日本語 (Japanese)" Command="{Binding SetLanguageCommand}" CommandParameter="ja" />
                    <MenuFlyoutItem Text="Português (Portuguese)" Command="{Binding SetLanguageCommand}" CommandParameter="pt" />
                </MenuFlyoutSubItem>
            </MenuBarItem>
            <MenuBarItem x:Name="HelpMenuBarItem" Title="مساعدة">
                <MenuFlyoutItem x:Name="MenuMarkdownGuideItem" Text="📖 دليل الماركداون" Click="MarkdownGuide_Click" />
                <MenuFlyoutItem x:Name="MenuJsonGuideItem" Text="🌳 دليل الجيسون ومسار JSONPath" Click="JsonGuide_Click" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem x:Name="MenuShortcutsItem" Text="⌨️ اختصارات لوحة المفاتيح  (F1)" Click="KeyboardShortcuts_Click" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem x:Name="MenuAboutItem" Text="ℹ️ عن البرنامج" Click="About_Click" />
            </MenuBarItem>
        </MenuBar>

        <!-- Main content area with collapsible workspace sidebar -->
        <SplitView
            x:Name="WorkspaceSplitView"
            Grid.Row="2"
            IsPaneOpen="{Binding IsWorkspacePaneOpen, Mode=TwoWay}"
            DisplayMode="Inline"
            OpenPaneLength="260"
            CompactPaneLength="0"
            Background="{ThemeResource AppBackgroundBrush}"
            PaneBackground="{ThemeResource AppBackgroundBrush}">
            <SplitView.Pane>
                <Grid BorderBrush="{ThemeResource AppBorderBrush}" BorderThickness="0,0,1,0" Padding="8,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Margin="4,0,4,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="WORKSPACE" FontWeight="Bold" FontSize="11" Foreground="{ThemeResource AppSecondaryTextBrush}" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Content="📁" Width="26" Height="26" Margin="6,0,4,0" Padding="0" FontSize="11" Command="{Binding OpenFolderCommand}" ToolTipService.ToolTip="Open workspace folder / فتح مجلد العمل (Ctrl+Shift+O)" />
                        <Button Grid.Column="2" Content="✕" Width="26" Height="26" Padding="0" FontSize="11" Command="{Binding ToggleWorkspacePaneCommand}" ToolTipService.ToolTip="Close workspace sidebar / إغلاق (Ctrl+B)" />
                    </Grid>
                    <TreeView
                        x:Name="WorkspaceTreeView"
                        Grid.Row="1"
                        ItemsSource="{Binding WorkspaceNodes}"
                        ItemInvoked="WorkspaceTreeView_ItemInvoked"
                        AutomationProperties.Name="Workspace files">
                        <TreeView.ItemTemplate>
                            <DataTemplate x:DataType="shellVm:FolderNodeViewModel">
                                <TreeViewItem ItemsSource="{Binding Children}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="{Binding Glyph}" FontSize="14" Foreground="{ThemeResource AppSecondaryTextBrush}" />
                                        <TextBlock Text="{Binding Name}" FontSize="13" VerticalAlignment="Center" />
                                    </StackPanel>
                                </TreeViewItem>
                            </DataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </Grid>
            </SplitView.Pane>
            <SplitView.Content>
                <Frame x:Name="RootFrame" />
            </SplitView.Content>
        </SplitView>
    </Grid>
</Window>
