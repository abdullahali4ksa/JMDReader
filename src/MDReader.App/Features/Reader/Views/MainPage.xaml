<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="MDReader.App.Features.Reader.Views.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:MDReader.App.Shared.Converters"
    xmlns:viewModels="using:MDReader.App.Features.Reader.ViewModels"
    xmlns:docs="using:MDReader.Core.Documents"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter" />
    </Page.Resources>

    <!--
        Main content area of the application.
        Shows open document tabs at the top, modern toolbars,
        the dual-pane editor, outline sidebar, Antigravity preview, comments drawer,
        and bottom reading statistics status bar.
    -->
    <Grid
        Background="{ThemeResource AppBackgroundBrush}"
        TabFocusNavigation="Cycle"
        AutomationProperties.Name="Main reader content">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Document Tabs -->
        <TabView
            x:Name="DocumentTabs"
            Grid.Row="0"
            TabItemsSource="{Binding Tabs}"
            SelectedItem="{Binding SelectedTab, Mode=TwoWay}"
            AddTabButtonClick="DocumentTabs_AddTabButtonClick"
            TabCloseRequested="DocumentTabs_TabCloseRequested"
            IsAddTabButtonVisible="True"
            Background="{ThemeResource AppBackgroundBrush}"
            BorderBrush="{ThemeResource AppBorderBrush}"
            BorderThickness="0,0,0,1"
            Visibility="{Binding IsNormalUiVisible, Converter={StaticResource BoolToVisibilityConverter}}"
            AutomationProperties.Name="Open document tabs">
            <TabView.TabItemTemplate>
                <DataTemplate x:DataType="viewModels:DocumentTabViewModel">
                    <TabViewItem
                        Header="{Binding Header}"
                        IsClosable="True"
                        AutomationProperties.Name="{Binding Header}">
                        <TabViewItem.IconSource>
                            <FontIconSource Glyph="&#xE8A5;" />
                        </TabViewItem.IconSource>
                    </TabViewItem>
                </DataTemplate>
            </TabView.TabItemTemplate>
        </TabView>

        <!-- Main Toolbar (View Modes + Formatting + Reading Tools + Export + Zoom + File Path Info) -->
        <Border
            x:Name="MainToolbar"
            Grid.Row="1"
            Background="{ThemeResource AppSubtleBackgroundBrush}"
            BorderBrush="{ThemeResource AppBorderBrush}"
            BorderThickness="0,0,0,1"
            Padding="12,6"
            Visibility="{Binding HasDocument, Converter={StaticResource BoolToVisibilityConverter}}"
            AutomationProperties.Name="Document toolbar">
            <StackPanel Spacing="6" Visibility="{Binding IsNormalUiVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Left: Scrollable or adaptive pill command groups -->
                    <ScrollViewer Grid.Column="0" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" HorizontalScrollMode="Enabled" VerticalScrollMode="Disabled">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <!-- View Modes Group (Pill cluster) -->
                            <Border Background="{ThemeResource AppBackgroundBrush}" BorderBrush="{ThemeResource AppBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="2">
                                <StackPanel Orientation="Horizontal" Spacing="2">
                                    <Button Content="◫" Width="30" Height="28" Padding="0" FontSize="13" Command="{Binding SwitchViewModeCommand}" CommandParameter="Split" ToolTipService.ToolTip="{Binding Strings.TooltipSplit, FallbackValue='Split View'}" />
                                    <Button Content="✏️" Width="30" Height="28" Padding="0" FontSize="12" Command="{Binding SwitchViewModeCommand}" CommandParameter="Editor" ToolTipService.ToolTip="{Binding Strings.TooltipEditor, FallbackValue='Editor Only'}" />
                                    <Button Content="📖" Width="30" Height="28" Padding="0" FontSize="12" Command="{Binding SwitchViewModeCommand}" CommandParameter="Preview" ToolTipService.ToolTip="{Binding Strings.TooltipRead, FallbackValue='Reading Mode'}" />
                                </StackPanel>
                            </Border>

                            <!-- Formatting Group (Pill cluster, visible in Split & Editor) -->
                            <Border Background="{ThemeResource AppBackgroundBrush}" BorderBrush="{ThemeResource AppBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="2" Visibility="{Binding IsEditorVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                                <StackPanel Orientation="Horizontal" Spacing="2">
                                    <Button Content="B" FontWeight="Bold" Width="28" Height="28" Padding="0" FontSize="12" Command="{Binding InsertMarkdownSyntaxCommand}" CommandParameter="bold" ToolTipService.ToolTip="{Binding Strings.TooltipBold, FallbackValue='Bold (**text**)'}" />
                                    <Button Content="I" FontStyle="Italic" Width="28" Height="28" Padding="0" FontSize="12" Command="{Binding InsertMarkdownSyntaxCommand}" CommandParameter="italic" ToolTipService.ToolTip="{Binding Strings.TooltipItalic, FallbackValue='Italic (*text*)'}" />
                                    <Button Content="H" Width="28" Height="28" Padding="0" FontSize="12" Command="{Binding InsertMarkdownSyntaxCommand}" CommandParameter="heading" ToolTipService.ToolTip="{Binding Strings.TooltipHeading, FallbackValue='Heading (# Title)'}" />
                                    <Button Content="&lt;&gt;" Width="28" Height="28" Padding="0" FontSize="11" Command="{Binding InsertMarkdownSyntaxCommand}" CommandParameter="code" ToolTipService.ToolTip="{Binding Strings.TooltipCode, FallbackValue='Code Block (```)'}" />
                                    <Button Content="📊" Width="28" Height="28" Padding="0" FontSize="12" Command="{Binding InsertMarkdownSyntaxCommand}" CommandParameter="mermaid" ToolTipService.ToolTip="{Binding Strings.TooltipMermaid, FallbackValue='Mermaid Diagram'}" />
                                    <Button Content="💡" Width="28" Height="28" Padding="0" FontSize="12" Command="{Binding InsertMarkdownSyntaxCommand}" CommandParameter="alert" ToolTipService.ToolTip="{Binding Strings.TooltipAlert, FallbackValue='Alert ([!NOTE])'}" />
                                    <Button Content="∑" Width="28" Height="28" Padding="0" FontSize="13" Command="{Binding InsertMarkdownSyntaxCommand}" CommandParameter="math" ToolTipService.ToolTip="{Binding Strings.TooltipMath, FallbackValue='Math ($$)'}" />
                                </StackPanel>
                            </Border>

                            <!-- Reading Tools Group (Pill cluster) -->
                            <Border Background="{ThemeResource AppBackgroundBrush}" BorderBrush="{ThemeResource AppBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="2">
                                <StackPanel Orientation="Horizontal" Spacing="2">
                                    <Button Content="📑" Width="30" Height="28" Padding="0" FontSize="13" Command="{Binding ToggleOutlinePaneCommand}" ToolTipService.ToolTip="{Binding Strings.TooltipOutline, FallbackValue='Outline / فهرس العناوين'}" />
                                    <Button Content="{Binding AutoScrollGlyph}" Width="30" Height="28" Padding="0" FontSize="12" Command="{Binding ToggleAutoScrollCommand}" ToolTipService.ToolTip="{Binding Strings.TooltipAutoScroll, FallbackValue='Smooth Auto-Scroll'}" />
                                    <ComboBox
                                        x:Name="ScrollSpeedCombo"
                                        SelectedIndex="1"
                                        SelectionChanged="ScrollSpeedCombo_SelectionChanged"
                                        Width="58"
                                        Height="28"
                                        Padding="4,1"
                                        FontSize="11"
                                        ToolTipService.ToolTip="{Binding Strings.TooltipAutoScrollSpeed, FallbackValue='Auto-Scroll Speed (1 - 5)'}">
                                        <ComboBoxItem Content="1x" Tag="1" />
                                        <ComboBoxItem Content="2x" Tag="2" />
                                        <ComboBoxItem Content="3x" Tag="3" />
                                        <ComboBoxItem Content="4x" Tag="4" />
                                        <ComboBoxItem Content="5x" Tag="5" />
                                    </ComboBox>
                                </StackPanel>
                            </Border>

                            <!-- Theme & Comments Group (Pill cluster) -->
                            <Border Background="{ThemeResource AppBackgroundBrush}" BorderBrush="{ThemeResource AppBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="2">
                                <StackPanel Orientation="Horizontal" Spacing="2">
                                    <Button Content="{Binding ThemeGlyph}" Width="30" Height="28" Padding="0" FontSize="13" Command="{Binding CycleThemeCommand}" ToolTipService.ToolTip="{Binding Strings.TooltipThemeToggle, FallbackValue='Cycle Theme'}" />
                                    <Button Content="💬" Width="30" Height="28" Padding="0" FontSize="13" Command="{Binding ToggleCommentsPaneCommand}" ToolTipService.ToolTip="{Binding Strings.TooltipComments, FallbackValue='Comments Drawer'}" />
                                </StackPanel>
                            </Border>

                            <!-- Export Group (Pill cluster) -->
                            <Border Background="{ThemeResource AppBackgroundBrush}" BorderBrush="{ThemeResource AppBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="2">
                                <StackPanel Orientation="Horizontal" Spacing="2">
                                    <Button Content="🖨️" Width="30" Height="28" Padding="0" FontSize="13" Click="ExportPdf_Click" ToolTipService.ToolTip="{Binding Strings.TooltipExportPdf, FallbackValue='Export to PDF'}" />
                                    <Button Content="🌐" Width="30" Height="28" Padding="0" FontSize="13" Click="ExportHtml_Click" ToolTipService.ToolTip="{Binding Strings.TooltipExportHtml, FallbackValue='Export to HTML'}" />
                                </StackPanel>
                            </Border>

                            <!-- Path Toggle & Zen Mode -->
                            <Button Content="📍" Width="30" Height="28" Padding="0" FontSize="13" Command="{Binding TogglePathBarVisibilityCommand}" ToolTipService.ToolTip="{Binding Strings.TooltipShowPath, FallbackValue='Toggle File Path / إظهار أو إخفاء مسار الملف'}" />
                            <Button Content="⛶" Width="30" Height="28" Padding="0" FontSize="13" Command="{Binding ToggleZenModeCommand}" ToolTipService.ToolTip="{Binding Strings.TooltipFocus, FallbackValue='Focus Mode (F11)'}" />
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Right: Zoom controls (Pill cluster) -->
                    <Border Grid.Column="1" Background="{ThemeResource AppBackgroundBrush}" BorderBrush="{ThemeResource AppBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="2" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="2">
                            <Button
                                x:Name="ZoomOutButton"
                                Content="−"
                                FontSize="16"
                                FontWeight="SemiBold"
                                Width="28"
                                Height="28"
                                Padding="0"
                                Command="{Binding ZoomOutCommand}"
                                AutomationProperties.Name="Zoom out"
                                ToolTipService.ToolTip="{Binding Strings.TooltipZoomOut, FallbackValue='Zoom Out (Ctrl+-)'}" />
                            <TextBlock
                                x:Name="ZoomPercentageText"
                                Text="{Binding ZoomPercentage}"
                                VerticalAlignment="Center"
                                MinWidth="38"
                                TextAlignment="Center"
                                FontSize="11"
                                Style="{StaticResource AppSecondaryTextStyle}"
                                AutomationProperties.Name="Zoom level"
                                ToolTipService.ToolTip="Zoom Level / نسبة التكبير" />
                            <Button
                                x:Name="ZoomInButton"
                                Content="+"
                                FontSize="16"
                                FontWeight="SemiBold"
                                Width="28"
                                Height="28"
                                Padding="0"
                                Command="{Binding ZoomInCommand}"
                                AutomationProperties.Name="Zoom in"
                                ToolTipService.ToolTip="{Binding Strings.TooltipZoomIn, FallbackValue='Zoom In (Ctrl++)'}" />
                            <Button
                                x:Name="ZoomResetButton"
                                Content="⟲"
                                FontSize="13"
                                Width="28"
                                Height="28"
                                Padding="0"
                                Command="{Binding ResetZoomCommand}"
                                AutomationProperties.Name="Reset zoom"
                                ToolTipService.ToolTip="{Binding Strings.TooltipResetZoom, FallbackValue='Reset Zoom 100% (Ctrl+0)'}" />
                        </StackPanel>
                    </Border>
                </Grid>

            <!-- Collapsible File Path Row (Collapses entirely to 0 height when hidden, saving reading space) -->
            <Border
                HorizontalAlignment="Left"
                Padding="6,2"
                Background="{ThemeResource AppSubtleBackgroundBrush}"
                BorderBrush="{ThemeResource AppBorderBrush}"
                BorderThickness="1"
                CornerRadius="4"
                Visibility="{Binding IsPathBarVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <Button
                        x:Name="CopyPathButton"
                        Click="CopyPathButton_Click"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="4,1"
                        CornerRadius="3"
                        ToolTipService.ToolTip="{Binding Strings.TooltipCopyPath, FallbackValue='Click to copy full path'}">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <TextBlock Text="📄" FontSize="11" VerticalAlignment="Center" />
                            <TextBlock
                                Text="{Binding CurrentDocumentPathDisplay}"
                                FontSize="11"
                                FontFamily="Cascadia Code, Consolas, Segoe UI Variable, sans-serif"
                                Foreground="{ThemeResource AppTextBrush}"
                                Opacity="0.8"
                                TextTrimming="CharacterEllipsis"
                                MaxWidth="680"
                                VerticalAlignment="Center" />
                            <TextBlock Text="📋" FontSize="10" Opacity="0.6" VerticalAlignment="Center" Margin="2,0,0,0" />
                        </StackPanel>
                    </Button>
                    <TextBlock
                        x:Name="PathCopiedBadge"
                        Text="{Binding Strings.TextPathCopied, FallbackValue='✓ تم نسخ المسار'}"
                        FontSize="11"
                        Foreground="{ThemeResource SystemAccentColor}"
                        FontWeight="SemiBold"
                        VerticalAlignment="Center"
                        Visibility="Collapsed" />
                    <Button
                        Content="✕"
                        Width="20"
                        Height="20"
                        Padding="0"
                        FontSize="10"
                        Background="Transparent"
                        BorderThickness="0"
                        CornerRadius="3"
                        Command="{Binding TogglePathBarVisibilityCommand}"
                        ToolTipService.ToolTip="{Binding Strings.TooltipHidePath, FallbackValue='Hide path bar'}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </Border>

        <Border
            x:Name="FindBar"
            Grid.Row="2"
            Padding="12,6"
            Background="{ThemeResource AppBackgroundBrush}"
            BorderBrush="{ThemeResource AppBorderBrush}"
            BorderThickness="0,0,0,1"
            Visibility="Collapsed"
            AutomationProperties.Name="Find and Replace in document">
            <StackPanel Spacing="6">
                <!-- Search row -->
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <TextBlock Text="Find:" VerticalAlignment="Center" FontWeight="SemiBold" Width="60" />
                    <TextBox x:Name="FindTextBox" Width="240"
                        PlaceholderText="Search in document..."
                        TextChanged="FindTextBox_TextChanged"
                        KeyDown="FindTextBox_KeyDown"
                        AutomationProperties.Name="Search text" />
                    <ToggleButton x:Name="MatchCaseToggle" Content="Aa" Click="FindOption_Changed" ToolTipService.ToolTip="Match Case (حساس لحالة الأحرف)" Width="32" Height="32" Padding="0" />
                    <ToggleButton x:Name="RegexToggle" Content=".*" Click="FindOption_Changed" ToolTipService.ToolTip="Regular Expression (تعبيرات نمطية)" Width="32" Height="32" Padding="0" />
                    <Button Content="▲ Prev" Click="FindPrevious_Click" ToolTipService.ToolTip="Previous match (Shift+Enter)" />
                    <Button Content="▼ Next" Click="FindNext_Click" ToolTipService.ToolTip="Next match (Enter)" />
                    <TextBlock x:Name="FindStatusText" VerticalAlignment="Center" MinWidth="80" Foreground="{ThemeResource AppSecondaryTextBrush}" />
                    <TextBlock x:Name="FindPreviewText" VerticalAlignment="Center" MaxWidth="320" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource AppSecondaryTextBrush}" />
                    <Button Content="✕" Width="28" Height="28" Padding="0" Click="CloseFind_Click" ToolTipService.ToolTip="Close (Esc)" />
                </StackPanel>
                <!-- Replace row -->
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <TextBlock Text="Replace:" VerticalAlignment="Center" FontWeight="SemiBold" Width="60" />
                    <TextBox x:Name="ReplaceTextBox" Width="240"
                        PlaceholderText="Replace with..."
                        KeyDown="ReplaceTextBox_KeyDown"
                        AutomationProperties.Name="Replace text" />
                    <Button Content="Replace" Click="Replace_Click" ToolTipService.ToolTip="Replace current match" />
                    <Button Content="Replace All" Click="ReplaceAll_Click" ToolTipService.ToolTip="Replace all matches across the document" />
                    <TextBlock x:Name="ReplaceStatusText" VerticalAlignment="Center" Foreground="{ThemeResource AppSecondaryTextBrush}" Margin="8,0,0,0" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Workspace Grid: Outline (Col 0) + Editor (Col 1) + Divider (Col 2) + Preview (Col 3) + Comments (Col 4) -->
        <Grid
            Grid.Row="3"
            Visibility="{Binding HasDocument, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="OutlineCol" Width="Auto" />
                <ColumnDefinition x:Name="EditorCol" Width="*" />
                <ColumnDefinition x:Name="DividerCol" Width="Auto" />
                <ColumnDefinition x:Name="PreviewCol" Width="*" />
                <ColumnDefinition x:Name="CommentsCol" Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Table of Contents / Outline Drawer Panel (Column 0) -->
            <Border
                x:Name="OutlineDrawer"
                Grid.Column="0"
                Width="250"
                Background="{ThemeResource AppBackgroundBrush}"
                BorderBrush="{ThemeResource AppBorderBrush}"
                BorderThickness="0,0,1,0"
                Padding="12,10"
                Visibility="{Binding IsOutlinePaneOpen, Converter={StaticResource BoolToVisibilityConverter}}"
                AutomationProperties.Name="Table of contents drawer">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Strings.DrawerOutlineTitle, FallbackValue='📑 OUTLINE'}" FontWeight="Bold" FontSize="12" Foreground="{ThemeResource AppSecondaryTextBrush}" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="✕" Width="26" Height="26" Padding="0" FontSize="11" Command="{Binding ToggleOutlinePaneCommand}" ToolTipService.ToolTip="Close Outline" />
                    </Grid>

                    <ListView Grid.Row="1" ItemsSource="{Binding OutlineItems}" SelectionMode="Single" IsItemClickEnabled="True" ItemClick="OutlineListView_ItemClick">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="docs:DocumentOutlineItem">
                                <StackPanel Padding="2,4">
                                    <TextBlock Text="{Binding DisplayTitle}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <!-- Editor Pane (Column 1) -->
            <Grid
                Grid.Column="1"
                Visibility="{Binding IsEditorVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                Margin="8,8,4,8">
                <TextBox
                    x:Name="MarkdownEditorTextBox"
                    Text="{Binding DocumentContent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    AcceptsReturn="True"
                    TextWrapping="Wrap"
                    IsSpellCheckEnabled="False"
                    FontFamily="Cascadia Code, Consolas, Monaco, monospace"
                    FontSize="14"
                    Padding="16"
                    BorderBrush="{ThemeResource AppBorderBrush}"
                    Background="{ThemeResource AppBackgroundBrush}"
                    AllowDrop="True"
                    DragOver="MarkdownEditorTextBox_DragOver"
                    Drop="MarkdownEditorTextBox_Drop"
                    KeyDown="MarkdownEditorTextBox_KeyDown"
                    AutomationProperties.Name="Markdown editor input" />
            </Grid>

            <!-- Divider line (Column 2) -->
            <Border
                Grid.Column="2"
                Width="1"
                Background="{ThemeResource AppBorderBrush}"
                Visibility="{Binding IsSplitMode, Converter={StaticResource BoolToVisibilityConverter}}" />

            <!-- Antigravity Preview Pane (Column 3) -->
            <Grid
                Grid.Column="3"
                Visibility="{Binding IsPreviewVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                Margin="4,8,4,8">
                <WebView2
                    x:Name="AntigravityViewer"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    AutomationProperties.Name="Antigravity markdown viewer" />
            </Grid>

            <!-- Comments Drawer Panel (Column 4) -->
            <Border
                x:Name="CommentsDrawer"
                Grid.Column="4"
                Width="320"
                Background="{ThemeResource AppBackgroundBrush}"
                BorderBrush="{ThemeResource AppBorderBrush}"
                BorderThickness="1,0,0,0"
                Padding="12,10"
                Visibility="{Binding IsCommentsPaneOpen, Converter={StaticResource BoolToVisibilityConverter}}"
                AutomationProperties.Name="Comments Drawer">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Strings.DrawerCommentsTitle, FallbackValue='💬 COMMENTS &amp; NOTES'}" FontWeight="Bold" FontSize="12" Foreground="{ThemeResource AppSecondaryTextBrush}" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="✕" Width="26" Height="26" Padding="0" FontSize="11" Command="{Binding ToggleCommentsPaneCommand}" ToolTipService.ToolTip="Close Comments" />
                    </Grid>

                    <!-- Add Comment Box -->
                    <Border Grid.Row="1" Background="{ThemeResource AppBackgroundBrush}" BorderBrush="{ThemeResource AppBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,0,10">
                        <StackPanel Spacing="6">
                            <!-- Selected quote preview if any -->
                            <Grid Visibility="{Binding SelectedQuoteText, Converter={StaticResource StringToVisibilityConverter}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding SelectedQuoteText}" MaxLines="2" TextTrimming="CharacterEllipsis" FontSize="11" FontStyle="Italic" Foreground="{ThemeResource AppSecondaryTextBrush}" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Content="✕" Width="20" Height="20" Padding="0" FontSize="10" Command="{Binding ClearQuoteCommand}" ToolTipService.ToolTip="Clear quoted text" />
                            </Grid>
                            <TextBox x:Name="NewCommentInput" PlaceholderText="{Binding Strings.CommentPlaceholder, FallbackValue='Write a comment or annotation...'}" Text="{Binding NewCommentText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="64" FontSize="12" />
                            <Button Content="{Binding Strings.ButtonAddComment, FallbackValue='➕ Add Comment'}" HorizontalAlignment="Right" Padding="8,4" FontSize="11" Command="{Binding AddCommentCommand}" />
                        </StackPanel>
                    </Border>

                    <!-- Comments List -->
                    <ListView Grid.Row="2" ItemsSource="{Binding Comments}" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="docs:DocumentComment">
                                <Border Margin="0,0,0,8" Padding="10" Background="{ThemeResource AppBackgroundBrush}" BorderBrush="{ThemeResource AppBorderBrush}" BorderThickness="1" CornerRadius="6">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid Grid.Row="0">
                                            <TextBlock Text="{Binding CreatedAtDisplay}" FontSize="10" Foreground="{ThemeResource AppSecondaryTextBrush}" VerticalAlignment="Center" />
                                            <Button Content="🗑️" HorizontalAlignment="Right" Padding="4,2" FontSize="10" Background="Transparent" BorderThickness="0" Click="DeleteComment_Click" ToolTipService.ToolTip="Delete Comment" />
                                        </Grid>
                                        <Border Grid.Row="1" Margin="0,4" Padding="6,4" Background="#14808080" CornerRadius="4" Visibility="{Binding SelectedText, Converter={StaticResource StringToVisibilityConverter}}">
                                            <TextBlock Text="{Binding SelectedText}" FontSize="11" FontStyle="Italic" TextWrapping="Wrap" />
                                        </Border>
                                        <TextBlock Grid.Row="2" Text="{Binding CommentText}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <!-- Floating Exit Zen Mode Button (shown only when in Focus Mode) -->
            <Button
                Grid.Column="3"
                Content="✕ Exit Focus Mode (F11)"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,16,24,0"
                Padding="12,6"
                FontSize="12"
                FontWeight="SemiBold"
                Background="{ThemeResource AppBackgroundBrush}"
                BorderBrush="{ThemeResource AppBorderBrush}"
                BorderThickness="1"
                CornerRadius="16"
                Command="{Binding ToggleZenModeCommand}"
                Visibility="{Binding IsZenMode, Converter={StaticResource BoolToVisibilityConverter}}"
                ToolTipService.ToolTip="Exit Fullscreen Focus Mode" />
        </Grid>

        <!-- Bottom Reading Analytics Status Bar (Row 4) -->
        <Border
            Grid.Row="4"
            Background="{ThemeResource AppBackgroundBrush}"
            BorderBrush="{ThemeResource AppBorderBrush}"
            BorderThickness="0,1,0,0"
            Padding="14,4"
            Visibility="{Binding IsNormalUiVisible, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid Visibility="{Binding HasDocument, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <!-- Left stats -->
                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <TextBlock Text="{Binding WordCountDisplay}" FontSize="11" Foreground="{ThemeResource AppSecondaryTextBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="•" FontSize="11" Foreground="{ThemeResource AppSecondaryTextBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding LineCountDisplay}" FontSize="11" Foreground="{ThemeResource AppSecondaryTextBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="•" FontSize="11" Foreground="{ThemeResource AppSecondaryTextBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding ReadingTimeDisplay}" FontSize="11" Foreground="{ThemeResource AppSecondaryTextBrush}" VerticalAlignment="Center" />
                </StackPanel>
                <!-- Right quick toggles (Icon-only pill cluster) -->
                <Border Grid.Column="1" Background="{ThemeResource AppSubtleBackgroundBrush}" BorderBrush="{ThemeResource AppBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="2" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="2">
                        <Button Content="📑" Width="28" Height="24" Padding="0" FontSize="12" Command="{Binding ToggleOutlinePaneCommand}" ToolTipService.ToolTip="{Binding Strings.TooltipOutline, FallbackValue='Table of Contents'}" />
                        <Button Content="💬" Width="28" Height="24" Padding="0" FontSize="12" Command="{Binding ToggleCommentsPaneCommand}" ToolTipService.ToolTip="{Binding Strings.TooltipComments, FallbackValue='Comments Drawer'}" />
                        <Button Content="⛶" Width="28" Height="24" Padding="0" FontSize="12" Command="{Binding ToggleZenModeCommand}" ToolTipService.ToolTip="{Binding Strings.TooltipFocus, FallbackValue='Focus Mode (F11)'}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Empty / welcome state -->
        <StackPanel
            x:Name="EmptyStatePanel"
            Grid.Row="3"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="12"
            MaxWidth="480"
            Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibilityConverter}}"
            AutomationProperties.Name="Empty reader state">
            <TextBlock
                Text="MDReader"
                FontSize="{StaticResource AppHeadingFontSize}"
                FontWeight="SemiBold"
                Foreground="{ThemeResource AppTextBrush}"
                HorizontalAlignment="Center"
                AutomationProperties.HeadingLevel="Level1" />
            <TextBlock
                Text="No document open"
                Style="{StaticResource AppBodyTextStyle}"
                HorizontalAlignment="Center" />
            <TextBlock
                Text="Select a Markdown file to read or click + to create a new one."
                Style="{StaticResource AppSecondaryTextStyle}"
                HorizontalAlignment="Center"
                TextAlignment="Center" />
        </StackPanel>

        <!-- Loading state -->
        <StackPanel
            x:Name="LoadingStatePanel"
            Grid.Row="3"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="12"
            Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"
            AutomationProperties.Name="Loading document">
            <ProgressRing IsActive="{Binding IsLoading}" Width="32" Height="32" />
            <TextBlock
                Text="Opening document…"
                Style="{StaticResource AppSecondaryTextStyle}"
                HorizontalAlignment="Center" />
        </StackPanel>

        <!-- Error state -->
        <Border
            x:Name="ErrorState"
            Grid.Row="3"
            Background="{ThemeResource AppBackgroundBrush}"
            Margin="24"
            Padding="20"
            CornerRadius="8"
            BorderBrush="{ThemeResource AppBorderBrush}"
            BorderThickness="1"
            Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}"
            AutomationProperties.Name="Error message">
            <StackPanel>
                <TextBlock
                    Text="Error"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource AppTextBrush}"
                    Style="{StaticResource AppBodyTextStyle}" />
                <TextBlock
                    Text="{Binding ErrorMessage}"
                    Foreground="{ThemeResource AppTextBrush}"
                    Style="{StaticResource AppSecondaryTextStyle}"
                    TextWrapping="Wrap" />
            </StackPanel>
        </Border>

    </Grid>
</Page>
