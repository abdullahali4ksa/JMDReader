<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="MDReader.App.Features.Shell.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:MDReader.App.Features.Shell.Views"
    xmlns:shellVm="using:MDReader.App.Features.Shell.ViewModels"
    xmlns:mu="using:Microsoft.UI.Xaml.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="{Binding WindowTitle}"
    mc:Ignorable="d">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid" TabFocusNavigation="Cycle" AutomationProperties.Name="MDReader application" AllowDrop="True" DragOver="RootGrid_DragOver" Drop="RootGrid_Drop">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar x:Name="AppTitleBar" Grid.Row="0" Title="{Binding WindowTitle}" AutomationProperties.Name="MDReader title bar">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="ms-appx:///Assets/AppIcon.ico" />
            </TitleBar.IconSource>
        </TitleBar>

        <!-- Menu bar: File, View, Settings -->
        <MenuBar Grid.Row="1" Background="{ThemeResource AppBackgroundBrush}" AutomationProperties.Name="Application menu bar">
            <MenuBarItem Title="{Binding Strings.MenuFile, FallbackValue='File'}">
                <MenuFlyoutItem Text="{Binding Strings.MenuNew, FallbackValue='New  (Ctrl+N)'}" Command="{Binding NewDocumentCommand}" />
                <MenuFlyoutItem Text="{Binding Strings.MenuOpenFile, FallbackValue='Open File...  (Ctrl+O)'}" Command="{Binding OpenDocumentCommand}" />
                <MenuFlyoutItem Text="{Binding Strings.MenuOpenFolder, FallbackValue='Open Folder...  (Ctrl+Shift+O)'}" Command="{Binding OpenFolderCommand}" />
                <MenuFlyoutSubItem x:Name="RecentFilesMenuSubItem" Text="🕒 Open Recent / الملفات المشاهدة مؤخراً" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="{Binding Strings.MenuSave, FallbackValue='Save  (Ctrl+S)'}" Command="{Binding SaveDocumentCommand}" />
                <MenuFlyoutItem Text="{Binding Strings.MenuSaveAs, FallbackValue='Save As...  (Ctrl+Shift+S)'}" Command="{Binding SaveDocumentAsCommand}" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="{Binding Strings.MenuCloseTab, FallbackValue='Close Tab  (Ctrl+W)'}" Command="{Binding CloseCurrentTabCommand}" />
            </MenuBarItem>
            <MenuBarItem Title="{Binding Strings.MenuView, FallbackValue='View'}">
                <MenuFlyoutItem Text="⚡ Command Palette...  (Ctrl+Shift+P / F2)" Click="CommandPalette_Click" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="{Binding Strings.MenuToggleSidebar, FallbackValue='Toggle Sidebar  (Ctrl+B)'}" Command="{Binding ToggleWorkspacePaneCommand}" />
                <MenuFlyoutItem Text="⌨️ Toggle Typewriter Mode / وضع الآلة الكاتبة" Click="ToggleTypewriter_Click" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="{Binding Strings.MenuRefresh, FallbackValue='Refresh  (Ctrl+R)'}" Command="{Binding RefreshDocumentCommand}" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="{Binding Strings.MenuFind, FallbackValue='Find...  (Ctrl+F)'}" Click="Find_Click" />
                <MenuFlyoutItem Text="Replace...  (Ctrl+H)" Click="Replace_Click" />
            </MenuBarItem>
            <MenuBarItem Title="{Binding Strings.MenuSettings, FallbackValue='Settings'}">
                <MenuFlyoutSubItem Text="{Binding Strings.MenuTheme, FallbackValue='🎨 Theme / المظهر'}">
                    <MenuFlyoutItem Text="💻 System / حسب النظام" Command="{Binding SetThemeCommand}" CommandParameter="System" />
                    <MenuFlyoutItem Text="{Binding Strings.MenuThemeLight, FallbackValue='☀️ Light (أبيض)'}" Command="{Binding SetThemeCommand}" CommandParameter="Light" />
                    <MenuFlyoutItem Text="{Binding Strings.MenuThemeDark, FallbackValue='🌙 Dark (داكن / أسود)'}" Command="{Binding SetThemeCommand}" CommandParameter="Dark" />
                    <MenuFlyoutItem Text="🌑 Dark Slate (رمادي غامق فاحم)" Command="{Binding SetThemeCommand}" CommandParameter="DarkSlate" />
                    <MenuFlyoutItem Text="{Binding Strings.MenuThemeSepia, FallbackValue='📜 Sepia (رمادي / بيج مريح للقراءة)'}" Command="{Binding SetThemeCommand}" CommandParameter="Sepia" />
                </MenuFlyoutSubItem>
                <MenuFlyoutSubItem Text="⚙️ Preferences &amp; Automation / الخيارات والأتمتة">
                    <ToggleMenuFlyoutItem x:Name="AutoSaveToggleItem" Text="💾 Auto-Save Drafts / حفظ المسودات تلقائياً" Click="AutoSaveToggle_Click" />
                    <ToggleMenuFlyoutItem x:Name="RestoreSessionToggleItem" Text="🔄 Restore Last Session Tabs / استئناف التابات السابقة" Click="RestoreSessionToggle_Click" />
                    <ToggleMenuFlyoutItem x:Name="TypewriterToggleItem" Text="⌨️ Typewriter Focus Mode / وضع الآلة الكاتبة" Click="TypewriterToggle_Click" />
                </MenuFlyoutSubItem>
                <MenuFlyoutSubItem Text="{Binding Strings.MenuLanguage, FallbackValue='🌐 Language / اللغة'}">
                    <MenuFlyoutItem Text="العربية (Arabic)" Command="{Binding SetLanguageCommand}" CommandParameter="ar" />
                    <MenuFlyoutItem Text="English" Command="{Binding SetLanguageCommand}" CommandParameter="en" />
                    <MenuFlyoutItem Text="中文 (Chinese Simplified)" Command="{Binding SetLanguageCommand}" CommandParameter="zh" />
                    <MenuFlyoutItem Text="हिन्दी (Hindi)" Command="{Binding SetLanguageCommand}" CommandParameter="hi" />
                    <MenuFlyoutItem Text="Español (Spanish)" Command="{Binding SetLanguageCommand}" CommandParameter="es" />
                    <MenuFlyoutItem Text="Français (French)" Command="{Binding SetLanguageCommand}" CommandParameter="fr" />
                    <MenuFlyoutItem Text="Deutsch (German)" Command="{Binding SetLanguageCommand}" CommandParameter="de" />
                    <MenuFlyoutItem Text="Русский (Russian)" Command="{Binding SetLanguageCommand}" CommandParameter="ru" />
                    <MenuFlyoutItem Text="日本語 (Japanese)" Command="{Binding SetLanguageCommand}" CommandParameter="ja" />
                    <MenuFlyoutItem Text="Português (Portuguese)" Command="{Binding SetLanguageCommand}" CommandParameter="pt" />
                </MenuFlyoutSubItem>
            </MenuBarItem>
            <MenuBarItem Title="Help / مساعدة">
                <MenuFlyoutItem Text="📖 Markdown Syntax Guide / دليل الماركداون" Click="MarkdownGuide_Click" />
                <MenuFlyoutItem Text="🌳 JSON &amp; JSONPath Guide / دليل الجيسون" Click="JsonGuide_Click" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="{Binding Strings.MenuShortcuts, FallbackValue='⌨️ Keyboard Shortcuts  (F1)'}" Click="KeyboardShortcuts_Click" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="ℹ️ About JMDReader / عن البرنامج" Click="About_Click" />
            </MenuBarItem>
        </MenuBar>

        <!-- Main content area with collapsible workspace sidebar -->
        <SplitView
            x:Name="WorkspaceSplitView"
            Grid.Row="2"
            IsPaneOpen="{Binding IsWorkspacePaneOpen, Mode=TwoWay}"
            DisplayMode="Inline"
            OpenPaneLength="260"
            CompactPaneLength="0"
            Background="{ThemeResource AppBackgroundBrush}"
            PaneBackground="{ThemeResource AppBackgroundBrush}">
            <SplitView.Pane>
                <Grid BorderBrush="{ThemeResource AppBorderBrush}" BorderThickness="0,0,1,0" Padding="8,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Margin="4,0,4,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="WORKSPACE" FontWeight="Bold" FontSize="11" Foreground="{ThemeResource AppSecondaryTextBrush}" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Content="📁" Width="26" Height="26" Margin="6,0,4,0" Padding="0" FontSize="11" Command="{Binding OpenFolderCommand}" ToolTipService.ToolTip="Open workspace folder / فتح مجلد العمل (Ctrl+Shift+O)" />
                        <Button Grid.Column="2" Content="✕" Width="26" Height="26" Padding="0" FontSize="11" Command="{Binding ToggleWorkspacePaneCommand}" ToolTipService.ToolTip="Close workspace sidebar / إغلاق (Ctrl+B)" />
                    </Grid>
                    <TreeView
                        x:Name="WorkspaceTreeView"
                        Grid.Row="1"
                        ItemsSource="{Binding WorkspaceNodes}"
                        ItemInvoked="WorkspaceTreeView_ItemInvoked"
                        AutomationProperties.Name="Workspace files">
                        <TreeView.ItemTemplate>
                            <DataTemplate x:DataType="shellVm:FolderNodeViewModel">
                                <TreeViewItem ItemsSource="{Binding Children}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="{Binding Glyph}" FontSize="14" Foreground="{ThemeResource AppSecondaryTextBrush}" />
                                        <TextBlock Text="{Binding Name}" FontSize="13" VerticalAlignment="Center" />
                                    </StackPanel>
                                </TreeViewItem>
                            </DataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </Grid>
            </SplitView.Pane>
            <SplitView.Content>
                <Frame x:Name="RootFrame" />
            </SplitView.Content>
        </SplitView>
    </Grid>
</Window>
