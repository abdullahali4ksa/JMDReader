<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="MDReader.App.Features.Reader.Views.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:MDReader.App.Shared.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </Page.Resources>

    <!--
        Main content area of the application.
        Shows empty/welcome state, document content, or error state
        based on ReaderViewModel properties.
    -->
    <Grid
        Background="{ThemeResource AppBackgroundBrush}"
        TabFocusNavigation="Cycle">

        <!-- Document content (shown when a document is loaded) -->
        <ScrollViewer
            x:Name="DocumentContentViewer"
            Grid.Row="0"
            HorizontalScrollMode="Auto"
            VerticalScrollMode="Auto"
            Visibility="{Binding HasDocument, Converter={StaticResource BoolToVisibilityConverter}}"
            AutomationProperties.Name="Document content">
            <Border
                Background="{ThemeResource AppBackgroundBrush}"
                Margin="24"
                Padding="24"
                CornerRadius="8"
                BorderBrush="{ThemeResource AppBorderBrush}"
                BorderThickness="1">
                <StackPanel
                    x:Name="RenderedDocumentPanel"
                    Spacing="2" />
            </Border>
        </ScrollViewer>

        <!-- Empty / welcome state -->
        <StackPanel
            x:Name="EmptyStatePanel"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="12"
            MaxWidth="480"
            Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibilityConverter}}"
            AutomationProperties.Name="Empty reader state">
            <TextBlock
                Text="MDReader"
                FontSize="{StaticResource AppHeadingFontSize}"
                FontWeight="SemiBold"
                Foreground="{ThemeResource AppTextBrush}"
                HorizontalAlignment="Center"
                AutomationProperties.HeadingLevel="Level1" />
            <TextBlock
                Text="No document open"
                Style="{StaticResource AppBodyTextStyle}"
                HorizontalAlignment="Center" />
            <TextBlock
                Text="Select a Markdown file to read."
                Style="{StaticResource AppSecondaryTextStyle}"
                HorizontalAlignment="Center"
                TextAlignment="Center" />
        </StackPanel>

        <!-- Loading state (shown while a document is being parsed) -->
        <StackPanel
            x:Name="LoadingStatePanel"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="12"
            Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"
            AutomationProperties.Name="Loading document">
            <ProgressRing IsActive="{Binding IsLoading}" Width="32" Height="32" />
            <TextBlock
                Text="Opening document…"
                Style="{StaticResource AppSecondaryTextStyle}"
                HorizontalAlignment="Center" />
        </StackPanel>

        <!-- Error state -->
        <Border
            x:Name="ErrorState"
            Background="{ThemeResource AppBackgroundBrush}"
            Margin="24"
            Padding="20"
            CornerRadius="8"
            BorderBrush="{ThemeResource AppBorderBrush}"
            BorderThickness="1"
            Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}"
            AutomationProperties.Name="Error message">
            <StackPanel>
                <TextBlock
                    Text="Error"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource AppTextBrush}"
                    Style="{StaticResource AppBodyTextStyle}" />
                <TextBlock
                    Text="{Binding ErrorMessage}"
                    Foreground="{ThemeResource AppTextBrush}"
                    Style="{StaticResource AppSecondaryTextStyle}"
                    TextWrapping="Wrap" />
            </StackPanel>
        </Border>

    </Grid>
</Page>
