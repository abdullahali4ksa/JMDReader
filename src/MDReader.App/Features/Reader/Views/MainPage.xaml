<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="MDReader.App.Features.Reader.Views.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:MDReader.App.Shared.Converters"
    xmlns:viewModels="using:MDReader.App.Features.Reader.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </Page.Resources>

    <!--
        Main content area of the application.
        Shows open document tabs at the top, then toolbars, followed by
        the dual-pane editor & Antigravity preview or empty/error states.
    -->
    <Grid
        Background="{ThemeResource AppBackgroundBrush}"
        TabFocusNavigation="Cycle"
        AutomationProperties.Name="Main reader content">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Document Tabs -->
        <TabView
            x:Name="DocumentTabs"
            Grid.Row="0"
            TabItemsSource="{Binding Tabs}"
            SelectedItem="{Binding SelectedTab, Mode=TwoWay}"
            AddTabButtonClick="DocumentTabs_AddTabButtonClick"
            TabCloseRequested="DocumentTabs_TabCloseRequested"
            IsAddTabButtonVisible="True"
            Background="{ThemeResource AppBackgroundBrush}"
            BorderBrush="{ThemeResource AppBorderBrush}"
            BorderThickness="0,0,0,1"
            AutomationProperties.Name="Open document tabs">
            <TabView.TabItemTemplate>
                <DataTemplate x:DataType="viewModels:DocumentTabViewModel">
                    <TabViewItem
                        Header="{Binding Header}"
                        IsClosable="True"
                        AutomationProperties.Name="{Binding Header}">
                        <TabViewItem.IconSource>
                            <FontIconSource Glyph="&#xE8A5;" />
                        </TabViewItem.IconSource>
                    </TabViewItem>
                </DataTemplate>
            </TabView.TabItemTemplate>
        </TabView>

        <!-- Main Toolbar (View Mode Switcher + Formatting Toolbar + Zoom) -->
        <Border
            x:Name="MainToolbar"
            Grid.Row="1"
            Background="{ThemeResource AppBackgroundBrush}"
            BorderBrush="{ThemeResource AppBorderBrush}"
            BorderThickness="0,0,0,1"
            Padding="12,6"
            Visibility="{Binding HasDocument, Converter={StaticResource BoolToVisibilityConverter}}"
            AutomationProperties.Name="Document toolbar">
            <Grid>
                <!-- Left: View Mode Switcher + Quick Formatting Toolbar -->
                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Left">
                    <Button Content="◫ Split" Padding="8,4" FontSize="12" Command="{Binding SwitchViewModeCommand}" CommandParameter="Split" ToolTipService.ToolTip="Split View (Editor + Preview)" />
                    <Button Content="✏️ Edit" Padding="8,4" FontSize="12" Command="{Binding SwitchViewModeCommand}" CommandParameter="Editor" ToolTipService.ToolTip="Editor Only" />
                    <Button Content="📖 Read" Padding="8,4" FontSize="12" Command="{Binding SwitchViewModeCommand}" CommandParameter="Preview" ToolTipService.ToolTip="Preview Only (Antigravity Mode)" />

                    <AppBarSeparator />

                    <Button Content="B" FontWeight="Bold" Width="28" Height="28" Padding="0" Command="{Binding InsertMarkdownSyntaxCommand}" CommandParameter="bold" ToolTipService.ToolTip="Bold (**text**)" />
                    <Button Content="I" FontStyle="Italic" Width="28" Height="28" Padding="0" Command="{Binding InsertMarkdownSyntaxCommand}" CommandParameter="italic" ToolTipService.ToolTip="Italic (*text*)" />
                    <Button Content="H" Width="28" Height="28" Padding="0" Command="{Binding InsertMarkdownSyntaxCommand}" CommandParameter="heading" ToolTipService.ToolTip="Heading" />
                    <Button Content="&lt;&gt;" Width="28" Height="28" Padding="0" Command="{Binding InsertMarkdownSyntaxCommand}" CommandParameter="code" ToolTipService.ToolTip="Code block" />
                    <Button Content="📊 Mermaid" Padding="6,2" FontSize="11" Command="{Binding InsertMarkdownSyntaxCommand}" CommandParameter="mermaid" ToolTipService.ToolTip="Insert Mermaid diagram" />
                    <Button Content="💡 Alert" Padding="6,2" FontSize="11" Command="{Binding InsertMarkdownSyntaxCommand}" CommandParameter="alert" ToolTipService.ToolTip="Insert Antigravity Alert" />
                    <Button Content="∑ Math" Padding="6,2" FontSize="11" Command="{Binding InsertMarkdownSyntaxCommand}" CommandParameter="math" ToolTipService.ToolTip="Insert Math formula" />
                </StackPanel>

                <!-- Right: Zoom controls -->
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                    <Button
                        x:Name="ZoomOutButton"
                        Content="−"
                        FontSize="18"
                        FontWeight="SemiBold"
                        Width="32"
                        Height="32"
                        Padding="0"
                        Command="{Binding ZoomOutCommand}"
                        AutomationProperties.Name="Zoom out"
                        ToolTipService.ToolTip="Zoom out (Ctrl+-)" />
                    <TextBlock
                        x:Name="ZoomPercentageText"
                        Text="{Binding ZoomPercentage}"
                        VerticalAlignment="Center"
                        MinWidth="42"
                        TextAlignment="Center"
                        Style="{StaticResource AppSecondaryTextStyle}"
                        AutomationProperties.Name="Zoom level" />
                    <Button
                        x:Name="ZoomInButton"
                        Content="+"
                        FontSize="18"
                        FontWeight="SemiBold"
                        Width="32"
                        Height="32"
                        Padding="0"
                        Command="{Binding ZoomInCommand}"
                        AutomationProperties.Name="Zoom in"
                        ToolTipService.ToolTip="Zoom in (Ctrl++)" />
                    <Button
                        x:Name="ZoomResetButton"
                        Content="⟲"
                        FontSize="14"
                        Width="32"
                        Height="32"
                        Padding="0"
                        Command="{Binding ResetZoomCommand}"
                        AutomationProperties.Name="Reset zoom"
                        ToolTipService.ToolTip="Reset zoom (Ctrl+0)" />
                </StackPanel>
            </Grid>
        </Border>

        <Border
            x:Name="FindBar"
            Grid.Row="2"
            Padding="12,8"
            Background="{ThemeResource AppBackgroundBrush}"
            BorderBrush="{ThemeResource AppBorderBrush}"
            BorderThickness="0,0,0,1"
            Visibility="Collapsed"
            AutomationProperties.Name="Find in document">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <TextBlock Text="Find" VerticalAlignment="Center" />
                <TextBox x:Name="FindTextBox" Width="260"
                    PlaceholderText="Search this Markdown document"
                    TextChanged="FindTextBox_TextChanged"
                    KeyDown="FindTextBox_KeyDown"
                    AutomationProperties.Name="Search text" />
                <Button Content="Previous" Click="FindPrevious_Click" />
                <Button Content="Next" Click="FindNext_Click" />
                <TextBlock x:Name="FindStatusText" VerticalAlignment="Center" MinWidth="90" />
                <TextBlock x:Name="FindPreviewText" VerticalAlignment="Center" MaxWidth="360" TextTrimming="CharacterEllipsis" />
                <Button Content="Close" Click="CloseFind_Click" />
            </StackPanel>
        </Border>

        <!-- Dual Pane Workspace: Editor (Column 0) + Antigravity Preview (Column 2) -->
        <Grid
            Grid.Row="3"
            Visibility="{Binding HasDocument, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Editor Pane -->
            <Grid
                Grid.Column="0"
                Visibility="{Binding IsEditorVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                Margin="8,8,4,8">
                <TextBox
                    x:Name="MarkdownEditorTextBox"
                    Text="{Binding DocumentContent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    AcceptsReturn="True"
                    TextWrapping="Wrap"
                    IsSpellCheckEnabled="False"
                    FontFamily="Cascadia Code, Consolas, Monaco, monospace"
                    FontSize="14"
                    Padding="16"
                    BorderBrush="{ThemeResource AppBorderBrush}"
                    Background="{ThemeResource AppBackgroundBrush}"
                    AutomationProperties.Name="Markdown editor input" />
            </Grid>

            <!-- Divider line -->
            <Border
                Grid.Column="1"
                Width="1"
                Background="{ThemeResource AppBorderBrush}"
                Visibility="{Binding IsSplitMode, Converter={StaticResource BoolToVisibilityConverter}}" />

            <!-- Antigravity Preview Pane (WebView2) -->
            <Grid
                Grid.Column="2"
                Visibility="{Binding IsPreviewVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                Margin="4,8,8,8">
                <WebView2
                    x:Name="AntigravityViewer"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    AutomationProperties.Name="Antigravity markdown viewer" />
            </Grid>
        </Grid>

        <!-- Empty / welcome state -->
        <StackPanel
            x:Name="EmptyStatePanel"
            Grid.Row="3"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="12"
            MaxWidth="480"
            Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibilityConverter}}"
            AutomationProperties.Name="Empty reader state">
            <TextBlock
                Text="MDReader"
                FontSize="{StaticResource AppHeadingFontSize}"
                FontWeight="SemiBold"
                Foreground="{ThemeResource AppTextBrush}"
                HorizontalAlignment="Center"
                AutomationProperties.HeadingLevel="Level1" />
            <TextBlock
                Text="No document open"
                Style="{StaticResource AppBodyTextStyle}"
                HorizontalAlignment="Center" />
            <TextBlock
                Text="Select a Markdown file to read or click + to create a new one."
                Style="{StaticResource AppSecondaryTextStyle}"
                HorizontalAlignment="Center"
                TextAlignment="Center" />
        </StackPanel>

        <!-- Loading state -->
        <StackPanel
            x:Name="LoadingStatePanel"
            Grid.Row="3"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="12"
            Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"
            AutomationProperties.Name="Loading document">
            <ProgressRing IsActive="{Binding IsLoading}" Width="32" Height="32" />
            <TextBlock
                Text="Opening document…"
                Style="{StaticResource AppSecondaryTextStyle}"
                HorizontalAlignment="Center" />
        </StackPanel>

        <!-- Error state -->
        <Border
            x:Name="ErrorState"
            Grid.Row="3"
            Background="{ThemeResource AppBackgroundBrush}"
            Margin="24"
            Padding="20"
            CornerRadius="8"
            BorderBrush="{ThemeResource AppBorderBrush}"
            BorderThickness="1"
            Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}"
            AutomationProperties.Name="Error message">
            <StackPanel>
                <TextBlock
                    Text="Error"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource AppTextBrush}"
                    Style="{StaticResource AppBodyTextStyle}" />
                <TextBlock
                    Text="{Binding ErrorMessage}"
                    Foreground="{ThemeResource AppTextBrush}"
                    Style="{StaticResource AppSecondaryTextStyle}"
                    TextWrapping="Wrap" />
            </StackPanel>
        </Border>

    </Grid>
</Page>
