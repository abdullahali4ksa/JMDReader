<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mu="using:Microsoft.UI.Xaml">

    <!--
        Shared application styles and resources.
        Defines theme-aware brushes and typography used by the Shell and Reader.
        Light and Dark theme dictionaries keep the app consistent with Windows.
    -->
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="AppBackgroundBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="AppSubtleBackgroundBrush" Color="#F3F4F6" />
            <SolidColorBrush x:Key="AppTextBrush" Color="#1F1F1F" />
            <SolidColorBrush x:Key="AppSecondaryTextBrush" Color="#5F5F5F" />
            <SolidColorBrush x:Key="AppBorderBrush" Color="#D1D5DB" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="AppBackgroundBrush" Color="#1E1E1E" />
            <SolidColorBrush x:Key="AppSubtleBackgroundBrush" Color="#2A2A2A" />
            <SolidColorBrush x:Key="AppTextBrush" Color="#E0E0E0" />
            <SolidColorBrush x:Key="AppSecondaryTextBrush" Color="#A0A0A0" />
            <SolidColorBrush x:Key="AppBorderBrush" Color="#383838" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!-- Typography -->
    <x:Double x:Key="AppBodyFontSize">16</x:Double>
    <x:Double x:Key="AppHeadingFontSize">24</x:Double>

    <Style x:Key="AppBodyTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Variable" />
        <Setter Property="FontSize" Value="{StaticResource AppBodyFontSize}" />
        <Setter Property="Foreground" Value="{ThemeResource AppTextBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="AppSecondaryTextStyle" TargetType="TextBlock" BasedOn="{StaticResource AppBodyTextStyle}">
        <Setter Property="Foreground" Value="{ThemeResource AppSecondaryTextBrush}" />
    </Style>

</ResourceDictionary>
